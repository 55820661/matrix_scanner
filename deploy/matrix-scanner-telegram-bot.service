[Unit]
Description=Matrix Scanner Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/matrix-scanner
EnvironmentFile=-/etc/matrix-scanner/matrix-scanner.env
ExecStart=/opt/matrix-scanner/.venv/bin/matrix-scanner --config /etc/matrix-scanner/config.yaml telegram-bot
Restart=always
RestartSec=5
User=matrix-scanner
Group=matrix-scanner

[Install]
WantedBy=multi-user.target
